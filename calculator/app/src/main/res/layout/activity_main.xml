<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Display Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/display_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="end">

            <!-- Expression TextView -->
            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:gravity="end"
                android:minHeight="24dp"
                android:contentDescription="@string/expression_content_desc" />

            <!-- Display TextView -->
            <TextView
                android:id="@+id/tvDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="end"
                android:minHeight="60dp"
                android:contentDescription="@string/display_content_desc" />
        </LinearLayout>

        <!-- Button Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:useDefaultMargins="true">

            <!-- Row 1: 7 8 9 ÷ -->
            <Button
                android:id="@+id/btn7"
                style="@style/NumberButton"
                android:text="7"
                android:contentDescription="@string/btn_7_desc" />

            <Button
                android:id="@+id/btn8"
                style="@style/NumberButton"
                android:text="8"
                android:contentDescription="@string/btn_8_desc" />

            <Button
                android:id="@+id/btn9"
                style="@style/NumberButton"
                android:text="9"
                android:contentDescription="@string/btn_9_desc" />

            <Button
                android:id="@+id/btnDivide"
                style="@style/OperatorButton"
                android:text="÷"
                android:contentDescription="@string/btn_divide_desc" />

            <!-- Row 2: 4 5 6 × -->
            <Button
                android:id="@+id/btn4"
                style="@style/NumberButton"
                android:text="4"
                android:contentDescription="@string/btn_4_desc" />

            <Button
                android:id="@+id/btn5"
                style="@style/NumberButton"
                android:text="5"
                android:contentDescription="@string/btn_5_desc" />

            <Button
                android:id="@+id/btn6"
                style="@style/NumberButton"
                android:text="6"
                android:contentDescription="@string/btn_6_desc" />

            <Button
                android:id="@+id/btnMultiply"
                style="@style/OperatorButton"
                android:text="×"
                android:contentDescription="@string/btn_multiply_desc" />

            <!-- Row 3: 1 2 3 - -->
            <Button
                android:id="@+id/btn1"
                style="@style/NumberButton"
                android:text="1"
                android:contentDescription="@string/btn_1_desc" />

            <Button
                android:id="@+id/btn2"
                style="@style/NumberButton"
                android:text="2"
                android:contentDescription="@string/btn_2_desc" />

            <Button
                android:id="@+id/btn3"
                style="@style/NumberButton"
                android:text="3"
                android:contentDescription="@string/btn_3_desc" />

            <Button
                android:id="@+id/btnSubtract"
                style="@style/OperatorButton"
                android:text="-"
                android:contentDescription="@string/btn_subtract_desc" />

            <!-- Row 4: 0 . ⌫ + -->
            <Button
                android:id="@+id/btn0"
                style="@style/NumberButton"
                android:text="0"
                android:layout_columnSpan="2"
                android:layout_gravity="fill"
                android:contentDescription="@string/btn_0_desc" />

            <Button
                android:id="@+id/btnDecimal"
                style="@style/NumberButton"
                android:text="."
                android:contentDescription="@string/btn_decimal_desc" />

            <Button
                android:id="@+id/btnAdd"
                style="@style/OperatorButton"
                android:text="+"
                android:contentDescription="@string/btn_add_desc" />

            <!-- Row 5: C ⌫ = -->
            <Button
                android:id="@+id/btnClear"
                style="@style/SpecialButton"
                android:text="C"
                android:layout_columnSpan="2"
                android:layout_gravity="fill"
                android:contentDescription="@string/btn_clear_desc" />

            <Button
                android:id="@+id/btnBackspace"
                style="@style/SpecialButton"
                android:text="⌫"
                android:contentDescription="@string/btn_backspace_desc" />

            <Button
                android:id="@+id/btnEquals"
                style="@style/EqualsButton"
                android:text="="
                android:contentDescription="@string/btn_equals_desc" />

        </GridLayout>

    </LinearLayout>
</ScrollView>
