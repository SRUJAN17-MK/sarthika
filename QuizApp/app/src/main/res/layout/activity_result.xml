<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Trophy Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="72sp"
            android:layout_marginBottom="24dp" />

        <!-- Quiz Completed Title -->
        <TextView
            android:id="@+id/tvQuizCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_completed"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="32dp"
            android:gravity="center" />

        <!-- Results Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/result_card_background"
            android:padding="24dp"
            android:layout_marginBottom="32dp">

            <!-- Total Questions -->
            <TextView
                android:id="@+id/tvTotalQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"
                android:text="Total Questions: 10"
                android:contentDescription="@string/total_questions_desc" />

            <!-- Correct Answers -->
            <TextView
                android:id="@+id/tvCorrectAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/correct_answer"
                android:layout_marginBottom="12dp"
                android:text="Correct Answers: 0"
                android:contentDescription="@string/correct_answers_desc" />

            <!-- Incorrect Answers -->
            <TextView
                android:id="@+id/tvIncorrectAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/wrong_answer"
                android:layout_marginBottom="16dp"
                android:text="Incorrect Answers: 0"
                android:contentDescription="@string/incorrect_answers_desc" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/divider"
                android:layout_marginBottom="16dp" />

            <!-- Score Percentage -->
            <TextView
                android:id="@+id/tvScorePercentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:text="Score: 0%"
                android:contentDescription="@string/score_percentage_desc" />

        </LinearLayout>

        <!-- Buttons Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Restart Button -->
            <Button
                android:id="@+id/btnRestart"
                android:layout_width="160dp"
                android:layout_height="56dp"
                android:text="@string/restart_button"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/restart_button_desc" />

            <!-- Exit Button -->
            <Button
                android:id="@+id/btnExit"
                android:layout_width="160dp"
                android:layout_height="56dp"
                android:text="@string/exit_button"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/wrong_answer"
                android:textColor="@android:color/white"
                android:contentDescription="@string/exit_button_desc" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
